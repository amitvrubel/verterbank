generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum GrammaticalCase {
  NOMINATIVE
  ACCUSATIVE
  DATIVE
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  DETERMINER
  PREPOSITION
  CONJUNCTION
  PARTICLE
  INTERJECTION
  NUMERAL
  PROPER_NOUN
  OTHER
}

enum GrammaticalGender {
  MASC
  FEM
  NEUT
}

enum GrammaticalNumber {
  SG
  PL
}

enum PastAuxiliary {
  HABN
  ZAYN
  BOTH
}

enum Tense {
  PRESENT
  PAST
  FUTURE
}

enum Mood {
  INDICATIVE
  IMPERATIVE
  CONDITIONAL
}

enum Degree {
  POSITIVE
  COMPARATIVE
  SUPERLATIVE
}

model Headword {
  id         String        @id @default(cuid(2))
  orth       String
  searchOrth String
  status     PublishStatus @default(DRAFT)

  lexemes Lexeme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([orth])
  @@index([searchOrth])
}

model Lexeme {
  id         String   @id @default(cuid(2))
  headwordId String
  headword   Headword @relation(fields: [headwordId], references: [id], onDelete: Cascade)

  partOfSpeech      PartOfSpeech
  grammaticalGender GrammaticalGender?
  pastAuxiliary     PastAuxiliary?

  yivo   String?
  ipa    String?
  notes  String?
  status PublishStatus @default(DRAFT)

  senses Sense[]
  forms  Form[]

  usageLabels LexemeUsageLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  relationsFrom LexemeRelation[] @relation("RelationFrom")
  relationsTo   LexemeRelation[] @relation("RelationTo")

  @@unique([headwordId, partOfSpeech, grammaticalGender])
  @@index([headwordId, yivo])
}

model Sense {
  id       String @id @default(cuid(2))
  lexemeId String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  definitionYi String?
  glossYi      String?
  order        Int
  status       PublishStatus @default(DRAFT)

  examples     Example[]
  translations SenseTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([lexemeId, order])
}

model Example {
  id      String @id @default(cuid(2))
  senseId String
  sense   Sense  @relation(fields: [senseId], references: [id], onDelete: Cascade)

  textYi String
  order  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([senseId, order])
}

model SenseTranslation {
  id      String @id @default(cuid(2))
  senseId String
  sense   Sense  @relation(fields: [senseId], references: [id], onDelete: Cascade)

  lang  String
  text  String
  note  String?
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([senseId, lang, order])
}

model Form {
  id       String @id @default(cuid(2))
  lexemeId String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  valueOrth   String
  valueSearch String
  yivo        String?
  ipa         String?
  note        String?
  order       Int
  status      PublishStatus @default(DRAFT)

  // FeatureSet (nullable)
  number GrammaticalNumber?
  person Int? // keep Int now (1/2/3); validate in app layer
  tense  Tense?
  mood   Mood?
  degree Degree?
  gender GrammaticalGender?
  case   GrammaticalCase?

  usageLabels FormUsageLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([lexemeId, order])
  @@index([valueSearch])
}

model UsageLabel {
  id   String @id @default(cuid(2))
  slug String @unique
  name String

  lexemes LexemeUsageLabel[]
  forms   FormUsageLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LexemeUsageLabel {
  lexemeId String
  labelId  String

  lexeme Lexeme     @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  label  UsageLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([lexemeId, labelId])
  @@index([labelId])
}

model FormUsageLabel {
  formId  String
  labelId String

  form  Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  label UsageLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([formId, labelId])
  @@index([labelId])
}

enum RelationType {
  SYNOMYM
  ANTONYM
  RELATED
  DERIVED_FROM
  VARIANT_OF
}

model LexemeRelation {
  fromLexemeId String
  toLexemeId   String
  type         RelationType

  fromLexeme Lexeme @relation("RelationFrom", fields: [fromLexemeId], references: [id], onDelete: Cascade)
  toLexeme   Lexeme @relation("RelationTo", fields: [toLexemeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?

  @@id([fromLexemeId, toLexemeId])
  @@index([toLexemeId])
}

enum UserRole {
  EDITOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
model User {
  id           String     @id @default(cuid(2))
  email        String     @unique
  passwordHash String
  displayName  String?
  role         UserRole   @default(EDITOR)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
